@{
    ViewBag.Title = "Почетна";
}

<div class="glavni-kontejner">
    <div class="sadrzaj-teksta">
        <h1 class="glavni-naslov">
            Планирајте<br>
            Одобрите<br>
            Реализујте
        </h1>
        <p class="podnaslov">
            Управљање захтевима за изменом<br>
            софтвера од стране клијента
        </p>
    </div>
</div>

<style>
    body, html {
        margin: 0;
        padding: 0;
        background-color: #ffffff;
    }

    .glavni-kontejner {
        background-image: url('/Content/Slike/PozadinskaSlika.jfif');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        display: flex;
        align-items: center;
        min-height: calc(100vh - 70px);
        width: 100%;
        padding-left: 4vw;
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        box-sizing: border-box;
        overflow: hidden; /* Sprečava pojavu skrola tokom animacije */
    }

    .sadrzaj-teksta {
        display: flex;
        flex-direction: column;
        gap: 1.5vw;
        max-width: 60vw;
    }

    /* 1. Definicija animacije za ulazak teksta na ekran */
    @@keyframes pojaviSeKliziNagore {
        0% {
            opacity: 0;
            transform: translateY(40px); /* Počinje 40px niže */
        }

        100% {
            opacity: 1;
            transform: translateY(0); /* Vraća se na originalnu poziciju */
        }
    }

    .glavni-naslov {
        font-size: 7.5vw;
        color: #1a273b;
        line-height: 1.05;
        font-weight: 300;
        margin: 0;
        letter-spacing: -0.03em;
        /* NOVO: Početno stanje za animaciju i dodata tranzicija za hover */
        opacity: 0;
        animation: pojaviSeKliziNagore 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
        transition: color 0.4s ease, transform 0.4s ease, text-shadow 0.4s ease;
    }

        /* 2. Hover efekat za glavni naslov */
        .glavni-naslov:hover {
            color: #14498c; /* Prelazi u malo življu, ali i dalje ozbiljnu plavu */
            transform: translateY(-5px); /* Suptilno se podiže na gore */
            text-shadow: 0px 10px 20px rgba(20, 73, 140, 0.15); /* Mekana senka ispod teksta */
        }

    .podnaslov {
        font-size: 2.2vw;
        color: #2a374b;
        line-height: 1.3;
        font-weight: 400;
        margin: 0;
        /* NOVO: Animacija sa kašnjenjem (0.2s) da bi se učitalo nakon glavnog naslova */
        opacity: 0;
        animation: pojaviSeKliziNagore 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0.2s forwards;
        transition: opacity 0.3s ease;
    }

        /* 3. Hover efekat za podnaslov */
        .podnaslov:hover {
            opacity: 0.75; /* Blago se prosvetli kada se pređe mišem */
        }

    /* Responzivnost za mobilne telefone */
    @@media (max-width: 768px) {
        .glavni-kontejner {
            justify-content: center;
            text-align: center;
            padding: 20px;
        }

        .glavni-naslov {
            font-size: 3.5rem;
            /* Na mobilnom isključujemo hover podizanje da ne smeta prilikom skrolovanja */
            transform: none !important;
        }

        .podnaslov {
            font-size: 1.3rem;
        }
    }
</style>